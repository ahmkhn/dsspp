# Keep your real values in .env.local (or the existing .env).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_MAPBOX_KEY=your-public-mapbox-access-token
# Optional: omit to use the light map style.
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
# Set this to the deployed origin in production; local default is port 3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
